# Gemini — без ключа работает демо-режим с примерами рецептов
GEMINI_API_KEY=
# Модель (рекомендуется gemini-3.5-flash-lite или gemini-3.8-flash)
GEMINI_MODEL=gemini-3.5-flash-lite

# Turso (обязательно для продакшена на Vercel)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Локально без Turso используется file:local.db
# USE_LOCAL_DB=0  — полностью отключить БД

# Форс-админ по email (и сид через npm run seed:admin)
ADMIN_BOOTSTRAP_EMAIL=admin@tasty.ai
# Пароль только в .env.local — для npm run seed:admin (не коммитить)
ADMIN_BOOTSTRAP_PASSWORD=
